# Web3Forms Access Key (Optional)
# Obtain from https://web3forms.com
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Direct Contact Numbers (Public links only - no API/automation)
WHATSAPP_NUMBER=917723913729
CALL_NUMBER=+917723913729

# Supabase Configuration (Authentication, Database, Storage, RLS)
# Obtain from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
