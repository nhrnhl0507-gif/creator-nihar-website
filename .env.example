# Creator Nihar - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env with real credentials to GitHub.

# Contact Email Configuration
EMAIL_TO=nhrnhl0507@gmail.com
EMAIL_FROM=Creator Nihar <booking@creatornihar.co.in>

# Resend API Key (Optional - for direct transactional email)
# Obtain from https://resend.com
